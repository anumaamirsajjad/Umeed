# Required
ANTHROPIC_API_KEY=your_key_here

# Required — no default. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Server
PORT=5000
NODE_ENV=development

# Crisis classifier — cheap/fast model, runs on every message alongside the regex safety net
CRISIS_CLASSIFIER_MODEL=meta-llama/llama-3.1-8b-instruct

# CORS — must match the frontend origin
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
