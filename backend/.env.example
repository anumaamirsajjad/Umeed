# Required
ANTHROPIC_API_KEY=your_key_here

# Required — no default. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Server
PORT=5000
NODE_ENV=development

# Crisis classifier — free-tier model, runs on every message alongside the regex safety net.
# Must handle Roman Urdu/Punjabi idiom reliably, not just English. IMPORTANT: any classifier
# API failure (e.g. this model getting pulled from OpenRouter's free tier) fails safe to
# "ambiguous", which always escalates to a crisis alert — so a dead model here silently
# turns EVERY message into a false crisis alert, not just some. Watch for
# "Crisis classifier fail-safe triggered" spikes in the logs.
CRISIS_CLASSIFIER_MODEL=minimax/minimax-m3:free

# CORS — must match the frontend origin
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
